# Postgres connection string (Neon, Vercel Postgres, Supabase, or local).
# Local example: postgresql://postgres:postgres@localhost:5432/neravu
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/neravu"
# Optional direct (non-pooled) URL used only for migrations. Vercel + Neon sets this for you.
# DATABASE_URL_UNPOOLED=""
# Secret used to sign owner session cookies. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: WhatsApp (reminders, receipts, bills over WhatsApp). See README.
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_APP_SECRET=""
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_DISPLAY_NUMBER="916363462003"
