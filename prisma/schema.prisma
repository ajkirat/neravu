// Neravu data model. Money is stored as whole rupees (Int).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  // Shown on tenant messages and pay pages; optional
  businessName String?
  // UPI ID (e.g. name@bank) rent is paid to; enables tenant pay links
  upiId        String?
  // en | kn | te: the language the app opens in
  language     String    @default("en")
  emailVerifiedAt  DateTime?
  // How tenants pay: NONE (collect yourself) | UPI (direct to your UPI ID) | RAZORPAY (your own Razorpay account)
  paymentMode  String    @default("UPI")
  razorpayKeyId  String?
  // AES-256-GCM encrypted; never shown again after saving
  razorpayKeySecretEnc  String?
  razorpayWebhookSecretEnc  String?
  // True once the keys were saved and passed a live check
  razorpayEnabled  Boolean  @default(false)
  // Automatic WhatsApp reminders (needs WhatsApp to be connected by whoever runs Neravu)
  autoReminders  Boolean  @default(false)
  // Days before the due date to send a heads-up (0 = never)
  remindBefore  Int  @default(2)
  // Repeat overdue reminders every N days (0 = never)
  remindOverdueEvery  Int  @default(3)
  reminderLogs  ReminderLog[]
  // Sessions issued before this moment are rejected (set on password reset)
  passwordChangedAt DateTime?
  authTokens   AuthToken[]
  createdAt    DateTime   @default(now())
  properties   Property[]
  tenants      Tenant[]
  expenses     Expense[]
  leads        Lead[]
  complaints   Complaint[]
}

model Property {
  id        String    @id @default(cuid())
  ownerId   String
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  city      String?
  createdAt DateTime  @default(now())
  rooms     Room[]
  tenants   Tenant[]
  expenses  Expense[]
  leads     Lead[]
  complaints Complaint[]

  @@index([ownerId])
}

model Room {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  number     String
  floor      String?
  // Number of beds in the room (1 = single, 2 = double sharing, ...)
  sharing    Int
  // Default monthly rent per bed
  rent       Int
  createdAt  DateTime @default(now())
  beds       Bed[]

  @@unique([propertyId, number])
}

model Bed {
  id      String   @id @default(cuid())
  roomId  String
  room    Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label   String
  tenants Tenant[]

  @@unique([roomId, label])
}

model Tenant {
  id             String    @id @default(cuid())
  ownerId        String
  owner          Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bedId          String?
  bed            Bed?      @relation(fields: [bedId], references: [id], onDelete: SetNull)
  name           String
  phone          String
  email          String?
  occupation     String?
  idType         String?
  idNumber       String?
  emergencyName  String?
  emergencyPhone String?
  monthlyRent    Int
  deposit        Int       @default(0)
  // Day of month rent falls due (1-28)
  rentDueDay     Int
  moveInDate     DateTime
  noticeDate     DateTime?
  moveOutDate    DateTime?
  // ACTIVE | NOTICE | MOVED_OUT
  status         String    @default("ACTIVE")
  notes          String?
  // Unguessable token for the public /pay/<token> page
  payToken       String?   @unique
  // Set when the tenant taps "I've paid"; cleared when the owner records a payment
  payClaimedAt   DateTime?
  lastRemindedAt DateTime?
  // en | kn | te: language of messages and the pay page for this tenant
  language       String?
  complaints     Complaint[]
  reminderLogs   ReminderLog[]
  createdAt      DateTime  @default(now())
  charges        Charge[]
  payments       Payment[]

  @@index([ownerId, status])
  @@index([bedId])
}

model Charge {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // RENT | DEPOSIT | ELECTRICITY | MAINTENANCE | OTHER
  type        String
  // Billing month for rent, e.g. "2026-11"
  period      String?
  description String
  amount      Int
  dueDate     DateTime
  createdAt   DateTime @default(now())

  @@unique([tenantId, type, period])
  @@index([tenantId, dueDate])
}

model Payment {
  // Integer id doubles as the receipt number
  id        Int      @id @default(autoincrement())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount    Int
  // Id from the payment provider (e.g. Razorpay pay_xxx); unique so a webhook replay cannot double-count
  externalId String?  @unique
  paidOn    DateTime
  // CASH | UPI | BANK | CARD | OTHER
  method    String
  reference String?
  note      String?
  createdAt DateTime @default(now())

  @@index([tenantId, paidOn])
}

model Expense {
  id         String    @id @default(cuid())
  ownerId    String
  owner      Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  category   String
  amount     Int
  spentOn    DateTime
  note       String?
  // Shop or supplier name, usually read from a bill photo
  vendor     String?
  // MANUAL | SCAN
  source     String    @default("MANUAL")
  // Grand total printed on the bill, kept to flag mismatches with the items
  billTotal  Int?
  createdAt  DateTime  @default(now())
  items      ExpenseItem[]

  @@index([ownerId, spentOn])
}

model Lead {
  id         String    @id @default(cuid())
  ownerId    String
  owner      Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  name       String
  phone      String
  note       String?
  // QR | MANUAL
  source     String    @default("MANUAL")
  // NEW | CONTACTED | VISIT | WON | LOST
  status     String    @default("NEW")
  followUpOn DateTime?
  createdAt  DateTime  @default(now())

  @@index([ownerId, status])
}

model Complaint {
  id         String    @id @default(cuid())
  ownerId    String
  owner      Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  title      String
  details    String?
  // OPEN | IN_PROGRESS | RESOLVED
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now())

  @@index([ownerId, status])
}

// One-time links emailed to owners: password reset and email verification. Only a hash is stored.
model AuthToken {
  id        String    @id @default(cuid())
  ownerId   String
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // RESET | VERIFY
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId, kind])
}

// One line on a bill. Amount is the line total in whole rupees (quantity x rate).
model ExpenseItem {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  name      String
  quantity  Float   @default(1)
  amount    Int

  @@index([expenseId])
}

// One row per automatic WhatsApp reminder attempt, so the owner can see what went out.
model ReminderLog {
  id       String   @id @default(cuid())
  ownerId  String
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenantId String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  // DUE_SOON | OVERDUE | TEST
  kind     String
  // SENT | FAILED
  status   String
  amount   Int?
  // Short reason when it failed (never contains keys)
  detail   String?
  sentAt   DateTime @default(now())

  @@index([ownerId, sentAt])
  @@index([tenantId, kind, sentAt])
}
