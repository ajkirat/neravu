// Neravu data model. Money is stored as whole rupees (Int).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Owner {
  id                       String            @id @default(cuid())
  name                     String
  // Optional since login moved to mobile + name + password; kept for emails and a future forgot-password
  email                    String?           @unique
  phone                    String?
  // Last 10 digits of phone: what the owner signs in with. Unique, and never the same as a caretaker's.
  phoneKey                 String?           @unique
  passwordHash             String
  // Shown on tenant messages and pay pages; optional
  businessName             String?
  // Shown to new tenants in the welcome WhatsApp message (wifi, timings, rules)
  houseRules               String?
  // Send a WhatsApp receipt to the tenant after every payment (when WhatsApp is connected)
  autoReceipts             Boolean           @default(true)
  // How tenants' own UPI payments are confirmed: OWNER (tenant says paid, owner taps OK) | BANK (bank alert emails)
  payConfirm               String            @default("OWNER")
  // Secret part of this owner's bank-alert inbox address (Option C)
  bankInbox                String?           @unique
  // Last 4 digits of the account the alerts are for: alerts for any other account are ignored
  bankLast4                String?
  // Gmail's "confirm forwarding" message, shown to the owner once
  bankForwardNote          String?
  // UPI ID (e.g. name@bank) rent is paid to; enables tenant pay links
  upiId                    String?
  // en | kn | te: the language the app opens in
  language                 String            @default("en")
  emailVerifiedAt          DateTime?
  // How tenants pay: NONE (collect yourself) | UPI (direct to your UPI ID) | RAZORPAY (your own Razorpay account)
  paymentMode              String            @default("UPI")
  razorpayKeyId            String?
  // AES-256-GCM encrypted; never shown again after saving
  razorpayKeySecretEnc     String?
  razorpayWebhookSecretEnc String?
  // True once the keys were saved and passed a live check
  razorpayEnabled          Boolean           @default(false)
  // Automatic WhatsApp reminders (needs WhatsApp to be connected by whoever runs Neravu)
  autoReminders            Boolean           @default(false)
  // Days before the due date to send a heads-up (0 = never)
  remindBefore             Int               @default(2)
  // Repeat overdue reminders every N days (0 = never)
  remindOverdueEvery       Int               @default(3)
  reminderLogs             ReminderLog[]
  electricityBills         ElectricityBill[]
  staff                    Staff[]
  // Sessions issued before this moment are rejected (set on password reset)
  passwordChangedAt        DateTime?
  authTokens               AuthToken[]
  createdAt                DateTime          @default(now())
  properties               Property[]
  tenants                  Tenant[]
  expenses                 Expense[]
  leads                    Lead[]
  joinRequests             JoinRequest[]
  pendingExpenses          PendingExpense[]
  payClaims                PaymentClaim[]
  bankCredits              BankCredit[]
  tenantRequests           TenantRequest[]
  dayCloses                DayClose[]
  recurringJobs            RecurringJob[]
  complaints               Complaint[]
}

model Property {
  id           String        @id @default(cuid())
  ownerId      String
  owner        Owner         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  address      String?
  city         String?
  createdAt    DateTime      @default(now())
  rooms        Room[]
  tenants      Tenant[]
  expenses     Expense[]
  leads        Lead[]
  joinRequests JoinRequest[]
  complaints   Complaint[]

  @@index([ownerId])
}

model Room {
  id               String            @id @default(cuid())
  propertyId       String
  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  number           String
  floor            String?
  // Number of beds in the room (1 = single, 2 = double sharing, ...)
  sharing          Int
  // Default monthly rent per bed
  rent             Int
  createdAt        DateTime          @default(now())
  beds             Bed[]
  electricityBills ElectricityBill[]

  @@unique([propertyId, number])
}

model Bed {
  id      String   @id @default(cuid())
  roomId  String
  room    Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label   String
  tenants Tenant[]

  @@unique([roomId, label])
}

model Tenant {
  id                   String          @id @default(cuid())
  ownerId              String
  owner                Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId           String
  property             Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bedId                String?
  bed                  Bed?            @relation(fields: [bedId], references: [id], onDelete: SetNull)
  name                 String
  phone                String
  email                String?
  occupation           String?
  idType               String?
  idNumber             String?
  emergencyName        String?
  emergencyPhone       String?
  // Home address, for the police tenant register
  permanentAddress     String?
  monthlyRent          Int
  deposit              Int             @default(0)
  // Day of month rent falls due (1-28)
  rentDueDay           Int
  moveInDate           DateTime
  // Imported tenants: rent is billed from this date (older dues come in as an opening balance)
  billFrom             DateTime?
  // 1-99: the paise added to this tenant's UPI amount (e.g. Rs 8500.37) so a payment can be matched to them
  payCode              Int?
  // No reminders (automatic or in the Today list) until this date
  remindersPausedUntil DateTime?
  noticeDate           DateTime?
  moveOutDate          DateTime?
  // ACTIVE | NOTICE | MOVED_OUT
  status               String          @default("ACTIVE")
  notes                String?
  // Unguessable token for the public /pay/<token> page
  payToken             String?         @unique
  // Set when the tenant taps "I've paid"; cleared when the owner records a payment
  payClaimedAt         DateTime?
  lastRemindedAt       DateTime?
  // en | kn | te: language of messages and the pay page for this tenant
  language             String?
  complaints           Complaint[]
  reminderLogs         ReminderLog[]
  payClaims            PaymentClaim[]
  requests             TenantRequest[]
  createdAt            DateTime        @default(now())
  charges              Charge[]
  payments             Payment[]

  @@index([ownerId, status])
  @@index([bedId])
}

model Charge {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // RENT | DEPOSIT | ELECTRICITY | MAINTENANCE | OTHER
  type        String
  // Billing month for rent, e.g. "2026-11"
  period      String?
  description String
  amount      Int
  dueDate     DateTime
  // Set when the charge came from splitting an electricity bill
  billId      String?
  bill        ElectricityBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@unique([tenantId, type, period])
  @@index([tenantId, dueDate])
}

model Payment {
  // Integer id doubles as the receipt number
  id                Int       @id @default(autoincrement())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount            Int
  // Id from the payment provider (e.g. Razorpay pay_xxx); unique so a webhook replay cannot double-count
  externalId        String?   @unique
  // Which caretaker recorded it (kept as a name too, so it survives the caretaker being removed)
  recordedByStaffId String?
  recordedBy        Staff?    @relation(fields: [recordedByStaffId], references: [id], onDelete: SetNull)
  recordedByName    String?
  // Cash a caretaker collected: set when the owner confirms they received it
  handedOverAt      DateTime?
  paidOn            DateTime
  // CASH | UPI | BANK | CARD | OTHER
  method            String
  reference         String?
  note              String?
  createdAt         DateTime  @default(now())

  @@index([tenantId, paidOn])
}

model Expense {
  id             String          @id @default(cuid())
  ownerId        String
  owner          Owner           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  category       String
  amount         Int
  spentOn        DateTime
  note           String?
  // Shop or supplier name, usually read from a bill photo
  vendor         String?
  // MANUAL | SCAN | WHATSAPP
  source         String          @default("MANUAL")
  // Who added it when it was not the owner (caretaker name; kept if the caretaker is removed)
  addedByName    String?
  addedByStaffId String?
  // Saved even though it looked like an expense already added (the person chose "save anyway")
  mayBeDuplicate Boolean         @default(false)
  duplicateOfId  String?
  // Grand total printed on the bill, kept to flag mismatches with the items
  billTotal      Int?
  createdAt      DateTime        @default(now())
  items          ExpenseItem[]
  receipt        ExpenseReceipt?

  @@index([ownerId, spentOn])
}

model Lead {
  id         String    @id @default(cuid())
  ownerId    String
  owner      Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  name       String
  phone      String
  note       String?
  // QR | MANUAL
  source     String    @default("MANUAL")
  // NEW | CONTACTED | VISIT | WON | LOST
  status     String    @default("NEW")
  followUpOn DateTime?
  // CALLBACK | INFO: what the visitor asked for on the QR enquiry page
  want       String?
  createdAt  DateTime  @default(now())

  @@index([ownerId, status])
}

// A prospective tenant who filled the Join form (QR or WhatsApp link). Not billed
// and holds no bed until the owner approves it, which creates the Tenant.
model JoinRequest {
  id               String   @id @default(cuid())
  ownerId          String
  owner            Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name             String
  phone            String
  email            String?
  occupation       String?
  idType           String?
  idNumber         String?
  emergencyName    String?
  emergencyPhone   String?
  permanentAddress String?
  language         String?
  // PENDING | APPROVED | REJECTED
  status           String   @default("PENDING")
  tenantId         String?
  createdAt        DateTime @default(now())

  @@index([ownerId, status])
}

model Complaint {
  id         String    @id @default(cuid())
  ownerId    String
  owner      Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  title      String
  details    String?
  // OPEN | IN_PROGRESS | RESOLVED
  status     String    @default("OPEN")
  // OWNER (typed in the app) | TENANT (sent from the tenant's My PG link)
  source     String    @default("OWNER")
  photoMime  String?
  photo      Bytes?
  createdAt  DateTime  @default(now())

  @@index([ownerId, status])
}

// One-time links emailed to owners: password reset and email verification. Only a hash is stored.
model AuthToken {
  id        String    @id @default(cuid())
  ownerId   String
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // RESET | VERIFY
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId, kind])
}

// One line on a bill. Amount is the line total in whole rupees (quantity x rate).
model ExpenseItem {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  name      String
  quantity  Float   @default(1)
  amount    Int

  @@index([expenseId])
}

// One row per automatic WhatsApp reminder attempt, so the owner can see what went out.
model ReminderLog {
  id       String   @id @default(cuid())
  ownerId  String
  owner    Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenantId String?
  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  // DUE_SOON | OVERDUE | TEST
  kind     String
  // SENT | FAILED
  status   String
  amount   Int?
  // Short reason when it failed (never contains keys)
  detail   String?
  sentAt   DateTime @default(now())

  @@index([ownerId, sentAt])
  @@index([tenantId, kind, sentAt])
}

// The electricity bill for one room for one month, optionally from meter readings, and whether it was split into tenants' dues.
model ElectricityBill {
  id          String    @id @default(cuid())
  ownerId     String
  owner       Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  // "2026-10"
  period      String
  prevReading Float?
  currReading Float?
  // Rupees per unit
  rate        Float?
  // Total bill in whole rupees
  amount      Int
  // When it was added to tenants' dues
  appliedAt   DateTime?
  charges     Charge[]
  createdAt   DateTime  @default(now())

  @@unique([roomId, period])
  @@index([ownerId, period])
}

// A caretaker or manager: signs in with a phone number and a password the owner sets, and can only
// do the day-to-day jobs (collect rent, log complaints, follow up leads), never see profit or settings.
model Staff {
  id                String    @id @default(cuid())
  ownerId           String
  owner             Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  // Last 10 digits of the mobile number; unique so a number signs in to exactly one PG
  phone             String    @unique
  passwordHash      String
  // Switching this off signs them out immediately
  active            Boolean   @default(true)
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  payments          Payment[]

  @@index([ownerId])
}

// The bill photo behind an expense (sent on WhatsApp). Shrunk before storing.
model ExpenseReceipt {
  expenseId String   @id
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  mime      String
  data      Bytes
  // sha256 of the stored image (exact copies) and a 64-bit difference hash (near-identical photos)
  sha256    String?
  phash     String?
  createdAt DateTime @default(now())

  @@index([sha256])
}

// A bill photo sent to the WhatsApp number, waiting for the sender to reply Yes or No.
model PendingExpense {
  id         String   @id @default(cuid())
  ownerId    String
  owner      Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  staffId    String?
  senderName String
  // Sender's WhatsApp number (digits)
  waFrom     String
  // What the bill reader found: vendor, date, category, items, total
  data       Json
  mime       String
  image      Bytes
  // PENDING | ADDED | CANCELLED
  status     String   @default("PENDING")
  expenseId  String?
  createdAt  DateTime @default(now())

  @@index([waFrom, status])
  @@index([ownerId, createdAt])
}

// WhatsApp message ids already handled, so a webhook retry is not processed twice.
// Every call Meta makes to the WhatsApp webhook, kept a few days, so the check can show whether Meta calls at all.
model WaHook {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  result    String
}

model WaInbound {
  id        String   @id
  createdAt DateTime @default(now())
  // What Neravu did with the message, step by step (shown in the WhatsApp check)
  trace     String?
}

// A tenant says "I've paid" (Option A). It never counts as payment: only the owner's OK records one.
model PaymentClaim {
  id         String    @id @default(cuid())
  ownerId    String
  owner      Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Whole rupees they say they paid, and the paise tag shown to them
  amount     Int
  paise      Int       @default(0)
  utr        String?
  // PENDING | CONFIRMED | REJECTED
  status     String    @default("PENDING")
  paymentId  Int?
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([ownerId, status])
  @@index([tenantId, status])
}

// A credit read from the owner's bank alert email (Option C).
model BankCredit {
  id          String   @id @default(cuid())
  ownerId     String
  owner       Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  amountPaise Int
  utr         String?
  payer       String?
  bank        String?
  // MATCHED | UNMATCHED | IGNORED
  status      String
  tenantId    String?
  paymentId   Int?
  // One row per alert email, so a re-sent email is not counted twice
  msgHash     String   @unique
  createdAt   DateTime @default(now())

  @@index([ownerId, status])
}

// Something a tenant asked for from their My PG link that the owner must decide on (e.g. notice to leave).
model TenantRequest {
  id        String    @id @default(cuid())
  ownerId   String
  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // NOTICE
  kind      String
  date      DateTime?
  note      String?
  // PENDING | DONE | DISMISSED
  status    String    @default("PENDING")
  createdAt DateTime  @default(now())

  @@index([ownerId, status])
}

// The owner closed a day in the cash book: optionally with the cash they counted in hand.
model DayClose {
  id          String   @id @default(cuid())
  ownerId     String
  owner       Owner    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  day         DateTime
  cashCounted Int?
  note        String?
  closedAt    DateTime @default(now())

  @@unique([ownerId, day])
}

// A job that comes back every few weeks or months (tank cleaning, pest control, gas, RO service...).
model RecurringJob {
  id         String    @id @default(cuid())
  ownerId    String
  owner      Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  propertyId String?
  title      String
  // How often, in days
  everyDays  Int
  nextDue    DateTime
  lastDone   DateTime?
  lastDoneBy String?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@index([ownerId, nextDue])
}
